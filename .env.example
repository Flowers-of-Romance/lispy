# Pick one provider configuration.
# openai SDK + base_url 切替で「色々」対応。

# OpenRouter (推奨、100+ モデルに一本でアクセス)
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-4.7

# OpenAI 直
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5

# Anthropic 直 (OpenAI 互換 endpoint)
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-opus-4-7

# Local (Ollama)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Local (DwarfStar 4 / ds4 by antirez, DeepSeek V4 Flash on M-series Mac 128GB+)
# LLM_API_KEY=ds4
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=deepseek-v4-flash   # thinking mode 有効、reasoning 重め
# LLM_MODEL=deepseek-chat       # thinking 無効、応答速い (chat 向き)
