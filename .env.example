# Pick one provider configuration.
# openai SDK + base_url 切替で「色々」対応。

# Local (DwarfStar 4 / ds4 by antirez, DeepSeek V4 Flash on M-series Mac 128GB+)
LLM_API_KEY=ds4
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=deepseek-chat          # thinking 無効、応答速い (chat 向き)
# LLM_MODEL=deepseek-v4-flash    # thinking mode 有効、reasoning 重め

# OpenRouter (100+ モデルに一本でアクセス)
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-opus-4.7

# OpenAI 直
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5

# Anthropic 直 (OpenAI 互換 endpoint)
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-opus-4-7

# Local (Ollama)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- 呼び出し default (任意) ---
# agent 呼び出しの max_tokens。 2048 だと agentic な出力には足りないことが多い。
# LLM_MAX_TOKENS=4096
# thinking mode の default (ds4 / DeepSeek 系が extra_body の "think" を解釈する。
# 他 provider は未知 field として無視される)。 1/true/yes/on で有効。
# LLM_THINK=1

# --- 審査者 (judge) LLM (任意、self-modifying 運用では強く推奨) ---
# define-gate の install 審査と auto.lispy の judge-done が使う。
# executor (LLM_*) と訓練の違うモデルを据えることで独立審査になる。
# 3 つとも未設定なら executor に fallback (= 同じ重みの別文脈審査に弱まる)。
# JUDGE_API_KEY=sk-ant-...
# JUDGE_BASE_URL=https://api.anthropic.com/v1
# JUDGE_MODEL=claude-opus-4-8
# JUDGE_MAX_TOKENS=2048
# round 毎の証拠確認 (judge-done) 専用の model (任意)。 判定基準が prompt 側で
# チェックリスト化されているぶん要求能力が低く、 誤判定も NEXT 側 (1 round 余計に
# 回るだけ) に倒れるので、 gate / plan 審査 (JUDGE_MODEL) より安いモデルでよい。
# 未設定なら JUDGE_MODEL に fallback。
# JUDGE_MODEL_DONE=claude-sonnet-5

# --- define-gate (任意) ---
# agent 由来の保護 binding (agent-step / judge-done 等) 書き換えを審査する gate。
# default on。 off にすると agent の define が無審査で通る (開発・実験用)。
# LISPY_GATE=off

# --- ハーネス (任意) ---
# post-edit check / hooks / MCP はすべて明示 opt-in — cwd で検出しても自動実行しない
# (clone した repo 同梱の設定ファイルで任意コマンドが走るのを防ぐ)。
# 編集直後に自動実行するチェックコマンド ({file} は編集ファイルに置換)。
# LISPY_CHECK_CMD=ruff check {file}
# または .lispy-check ファイル (1 行目がコマンド) を明示指定。
# LISPY_CHECK_FILE=./.lispy-check
# hooks 設定ファイル。
# LISPY_HOOKS=./.lispy-hooks.json
# MCP 設定ファイル。 明示 opt-in 必須 — cwd の .lispy-mcp.json は検出案内のみで自動起動しない
# (repo 同梱設定で任意コマンドが走るのを防ぐ)。
# LISPY_MCP=./.lispy-mcp.json
# MCP request の timeout 秒。
# LISPY_MCP_TIMEOUT=60
# context window (auto-compaction の分母。 model に合わせる)。
# LISPY_CTX_WINDOW=200000

# --- 洗脳 / brainwash (任意) ---
# 生層 (host.db turns) → 蒸留層 (data/memory/) の consolidation。 洗うのは judge LLM。
# LISPY_MEMORY_DIR=./data/memory       # 蒸留層の場所
# BRAINWASH_MAX_TOKENS=8192            # 洗脳 1 回の出力上限 (記憶ファイル群を書き直す分)
# BRAINWASH_MAX_SESSIONS=10            # 1 回で洗う session 数の上限
# BRAINWASH_INDEX_MAX_LINES=100        # index.md の行数上限 (index-first 読みの規律)
