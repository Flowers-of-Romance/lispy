;; init.lispy — lispy 起動時に自動 load される S 式定義集
;;
;; ここに置くのは agent-step / compose 等の「言語の seed」。
;; Python (lispy.py) に hard-code しない方針: 核は S 式である、という宣言と一致させるため。
;; ユーザーは (load "init.lispy") を打つ必要なし — lispy.py の build_default_env が
;; _install_meta_primitives の末尾で自動 load する。
;;
;; 動かし方:
;;   - 起動時はここに書かれた binding が pre-defined になる
;;   - 走行中に (define agent-step (lambda (env input) ...)) で書き換えれば即反映
;;   - もっと派生 idiom が欲しければ (load "extras.lispy") (opt-in)

;; --- 古典的な関数合成 — FP の universal idiom として 1 つだけ pre-define ---
(define compose
  (lambda (f g) (lambda (x) (g (f x)))))

;; --- agent loop の本体 — lispy の核 ---
;; REPL の平文入力は Python の eval_ から (agent-step env input) として呼ばれる。
;; この binding を書き換えれば、 走行中の評価規則そのものが変わる。
;;
;; 旧版からの変更 (どれも長い自走で効く):
;;   - tool round の継続は自己呼び出しでなく recur — 深度 100 制限を消費しない
;;   - 継続時に空の user turn "" を積まない — 文脈汚染を防ぐ
;;   - tool round 上限 40 — 到達したら「tool を呼ばずまとめろ」 reminder を挟んで 1 回だけ呼ぶ
;;   - S 式応答の auto-eval — 応答が ( で始まる S 式なら agent-eval (origin="agent") で評価し、
;;     結果を <eval-result> として見せて続行。 保護 binding への define は define-gate の審査を通る
;;   - round 開始時に (context-over?) なら condense-context — token 閾値の auto-compaction
;;     (overflow の緊急網は Python 側 _emergency_compact が別に張っている)
;;   - tool 実行は dispatch-tools — batch が全部 read-only なら並列、 副作用があれば直列
;;   - 平文で終わろうとしたら stop-hook — .lispy-hooks.json の停止条件を満たすまで戻される
(define agent-step
  (lambda (env input)
    ((lambda (input rounds)
       (begin
         (if (context-over?) (condense-context) #f)
         (let ((env2 (if (eq? input "") env (append-turn env (make-turn "user" input)))))
           (let ((response (llm-call env2)))
             (let ((env3 (append-turn env2 response)))
               (if (has-tool-calls? response)
                   (begin
                     (fold (lambda (e t) (append-turn e t))
                           env3
                           (dispatch-tools (tool-calls response)))
                     (if (>= rounds 40)
                         (let ((final (llm-call (append-turn env3
                                        (make-turn "user"
                                          "<system-reminder>tool round の上限 (40) に達した。これ以上 tool を呼ばず、ここまでの結果と未完了の作業を平文でまとめること。</system-reminder>")))))
                           (begin (append-turn env3 final) final))
                         (recur "" (+ rounds 1))))
                   (let ((evaled (agent-eval (turn-content response))))
                     (if (eq? evaled #f)
                         (let ((nag (stop-hook (turn-content response))))
                           (if (eq? nag "")
                               response
                               (begin
                                 (append-turn env3 (make-turn "user" nag))
                                 (recur "" (+ rounds 1)))))
                         (if (>= rounds 40)
                             response
                             (begin
                               (append-turn env3
                                 (make-turn "user"
                                   (string-append "<eval-result>" evaled "</eval-result>")))
                               (recur "" (+ rounds 1))))))))))))
     input 0)))
