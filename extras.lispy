;; extras.lispy — lispy core から外した派生 idiom 集
;;
;; 使い方:
;;   main> (load "extras.lispy")
;;   (loaded 7 forms from /Users/.../extras.lispy)
;;
;; これらは pre-defined ではない (lispy の核は agent-step + compose のみ)。
;; 必要なときだけ load する。

;; map: tail-recursive (recur + accumulator + 末尾 reverse)。
;; 素朴な (cons (f (car ..)) (map f (cdr ..))) だと非末尾で stack を 食う ので、
;; lispy の 100 段制限を簡単に超えてしまう。 ここは iterative にしておく。
(define map
  (lambda (f lst)
    (let ((iter (lambda (l acc)
                  (if (null? l)
                      (reverse acc)
                      (recur (cdr l) (cons (f (car l)) acc))))))
      (iter lst (list)))))

;; 多視点レンズ: 1 値に N 個の λ を適用、 結果を list で返す
(define lens
  (lambda (fns x) (map (lambda (f) (f x)) fns)))

;; decorator (late binding): name で参照する λ に decorator を被せる
;; (wrap "critic" harshen) → (lambda (x) ((lookup "critic") (harshen x)))
(define wrap
  (lambda (name decorator)
    (lambda (x) ((lookup name) (decorator x)))))

;; archive の各 turn を関数で写像
(define transform-past
  (lambda (f) (map f (archive-turns))))

;; 同じ問いを k 回 LLM に投げる (eval-turn-pure で env を汚さない)
;; 自己再帰なので _sf_define の patch が必要 (既に入ってる)
(define probe
  (lambda (id k)
    (if (<= k 0)
        (list)
        (cons (eval-turn-pure id) (probe id (- k 1))))))

;; 弁証法: 2 つの λ を ping-pong (LLM 再帰深度上限 5 のため n=3 推奨)
(define debate
  (lambda (a b topic n)
    (if (<= n 0)
        (list)
        (let ((said (a topic)))
          (cons said (debate b a said (- n 1)))))))

;; persona pack — assoc list から key で dispatch
;; (from-pack '(("hi" greeter) ("bye" farewell)) "hi") → greeter
(define from-pack
  (lambda (pack key)
    (if (null? pack)
        (list)
        (if (= (car (car pack)) key)
            (car (cdr (car pack)))
            (from-pack (cdr pack) key)))))

;; condense — fold の alias (要約・統合用)
(define condense
  (lambda (f init xs) (fold f init xs)))


;; ===========================================================================
;; 基本 list 操作 — pure lambda、 core が薄い ぶんここで揃える
;; ===========================================================================

;; 要素数を数える。 tail-recursive (recur + acc)。
(define length
  (lambda (lst)
    (let ((iter (lambda (l n)
                  (if (null? l) n (recur (cdr l) (+ n 1))))))
      (iter lst 0))))

;; 順序を反転。 tail-recursive (acc に cons し続けるだけで自然に逆順になる)。
(define reverse
  (lambda (lst)
    (let ((iter (lambda (l acc)
                  (if (null? l) acc (recur (cdr l) (cons (car l) acc))))))
      (iter lst (list)))))

;; 2 つの list を連結。 a を reverse して逆順に b へ cons する (2 パスで tail)。
(define append
  (lambda (a b)
    (let ((iter (lambda (l acc)
                  (if (null? l) acc (recur (cdr l) (cons (car l) acc))))))
      (iter (reverse a) b))))

;; pred を満たす要素だけ残す。 tail-recursive (acc に cons → 最後に reverse)。
(define filter
  (lambda (pred lst)
    (let ((iter (lambda (l acc)
                  (if (null? l) (reverse acc)
                      (if (pred (car l))
                          (recur (cdr l) (cons (car l) acc))
                          (recur (cdr l) acc))))))
      (iter lst (list)))))

;; alist (`(k v)` ペアの list) から key に対応する pair を返す。 無ければ #f。
;; e.g. (assoc 'b (list (list 'a 1) (list 'b 2))) → (b 2)
(define assoc
  (lambda (key alist)
    (if (null? alist) #f
        (if (= key (car (car alist)))
            (car alist)
            (recur key (cdr alist))))))

;; lst の中に x があれば、 そこから先の sub-list を返す。 無ければ #f。
(define member
  (lambda (x lst)
    (if (null? lst) #f
        (if (= x (car lst))
            lst
            (recur x (cdr lst))))))


;; ===========================================================================
;; 制御フロー macro — defmacro で構文糖
;; ===========================================================================

;; cond の末尾節用。 `else` を truthy 定数として扱う。
(define else #t)

;; (when cond body...) — cond が真なら body を順に評価、 最後の値を返す。
(defmacro when (c &rest body)
  `(if ,c (begin ,@body) nil))

;; (unless cond body...) — when の対。
(defmacro unless (c &rest body)
  `(if ,c nil (begin ,@body)))

;; (cond (pred body...) (pred body...) ... (else body...))
;; 各節を順に試し、 最初の真の pred の body を評価。 どれも当たらなければ nil。
;; 再帰展開は eval 時に行う (clauses を順に分解しながら if に変換)。
(defmacro cond (&rest clauses)
  (if (null? clauses)
      nil
      `(if ,(car (car clauses))
           (begin ,@(cdr (car clauses)))
           (cond ,@(cdr clauses)))))


;; ===========================================================================
;; combinator — try / box が要るやつ
;; ===========================================================================

;; memoize: 関数 f を 1 引数の cache 付きに wrap。
;; cache は alist。 大きく成りすぎる用途には不向き (assoc が O(n))。
(define memoize
  (lambda (f)
    (let ((cache (box (list))))
      (lambda (x)
        (let ((hit (assoc x (unbox cache))))
          (if hit
              (car (cdr hit))                                    ;; cached value
              (let ((v (f x)))
                (begin
                  (set-box! cache (cons (list x v) (unbox cache)))
                  v))))))))

;; (with-retry n expr) — expr を最大 n 回 retry。 失敗ごとに 1 回試す。
;; 全部失敗すると最後の error を propagate。 n=0 なら expr を裸で評価。
(defmacro with-retry (n expr)
  (if (= n 0) expr
      `(try ,expr (catch (e) (with-retry ,(- n 1) ,expr)))))

;; (with-fallback expr fallback) — expr が error なら fallback を評価して返す。
(defmacro with-fallback (expr fallback)
  `(try ,expr (catch (e) ,fallback)))

;; (with-default expr default) — error なら default 定数を返す (副作用なし)。
(defmacro with-default (expr default)
  `(try ,expr (catch (e) ,default)))


;; ===========================================================================
;; numeric / predicate
;; ===========================================================================

(define inc (lambda (x) (+ x 1)))
(define dec (lambda (x) (- x 1)))

(define even? (lambda (n) (= (mod n 2) 0)))
(define odd?  (lambda (n) (not (= (mod n 2) 0))))

(define zero?     (lambda (n) (= n 0)))
(define positive? (lambda (n) (> n 0)))
(define negative? (lambda (n) (< n 0)))

;; (range start end) → (start ... end-1)
(define range
  (lambda (start end)
    (let ((iter (lambda (i acc)
                  (if (>= i end) (reverse acc)
                      (recur (+ i 1) (cons i acc))))))
      (iter start (list)))))

;; (iota n) → (0 1 ... n-1)
(define iota (lambda (n) (range 0 n)))


;; ===========================================================================
;; list 追加 op (tail-recursive)
;; ===========================================================================

;; (take n lst) — 先頭 n 要素
(define take
  (lambda (n lst)
    (let ((iter (lambda (i l acc)
                  (if (or (<= i 0) (null? l)) (reverse acc)
                      (recur (- i 1) (cdr l) (cons (car l) acc))))))
      (iter n lst (list)))))

;; (drop n lst) — 先頭 n 要素を捨てる
(define drop
  (lambda (n lst)
    (if (or (<= n 0) (null? lst)) lst
        (recur (- n 1) (cdr lst)))))

;; (nth n lst) — 0-indexed の n 番目要素 (out-of-range は #f)
(define nth
  (lambda (n lst)
    (if (null? lst) #f
        (if (= n 0) (car lst)
            (recur (- n 1) (cdr lst))))))

;; (last lst) — 最後の要素 (空 list は #f)
(define last
  (lambda (lst)
    (if (null? lst) #f
        (if (null? (cdr lst)) (car lst)
            (recur (cdr lst))))))

;; (every? pred lst) — 全部 pred が真なら #t
(define every?
  (lambda (pred lst)
    (if (null? lst) #t
        (if (pred (car lst)) (recur pred (cdr lst))
            #f))))

;; (any? pred lst) — 1 つでも pred が真なら #t
(define any?
  (lambda (pred lst)
    (if (null? lst) #f
        (if (pred (car lst)) #t
            (recur pred (cdr lst))))))

;; (zip a b) — 2 つの list を pair に。 短い方に合わせる。
(define zip
  (lambda (a b)
    (let ((iter (lambda (xs ys acc)
                  (if (or (null? xs) (null? ys)) (reverse acc)
                      (recur (cdr xs) (cdr ys)
                             (cons (list (car xs) (car ys)) acc))))))
      (iter a b (list)))))

;; (flatten lst) — 1 段だけ平坦化。 nested list なら適用しなおして 2 回呼ぶ。
(define flatten
  (lambda (lst)
    (if (null? lst) (list)
        (append (car lst) (flatten (cdr lst))))))


;; ===========================================================================
;; combinator
;; ===========================================================================

(define identity (lambda (x) x))
(define const    (lambda (x) (lambda (_) x)))         ;; ignore 入力で常に x
(define flip     (lambda (f) (lambda (a b) (f b a))))

;; (pipe x f g h) — x を左から順に関数適用。 ((compose f g h) x) と逆向き。
;; UNIX pipeline 的な書き味。 例: (pipe 5 inc inc inc) → 8
(define pipe
  (lambda (x &rest fns)
    (fold (lambda (acc f) (f acc)) x fns)))


;; ===========================================================================
;; sequential let — body 内で前の binding を参照できる
;; ===========================================================================

;; (let* ((a 1) (b (+ a 1))) ...) — let の bindings 部で逐次評価
;; lispy の let は並列束縛なので、 a を使って b を計算するには let* が要る。
;; 展開: 1 つずつネストした let に変換 (1 binding なら 1 let、 n 個なら n 重)。
(defmacro let* (bindings &rest body)
  (if (null? bindings)
      `(begin ,@body)
      `(let (,(car bindings))
         (let* ,(cdr bindings) ,@body))))


;; ===========================================================================
;; 軽量 pattern match
;; ===========================================================================
;;
;; (match expr
;;   (pattern body...)
;;   (pattern body...)
;;   ...)
;;
;; pattern:
;;   _            wildcard (どんな値にも match)
;;   <symbol>     任意の値に match して symbol に bind (body で参照可)
;;   <number>     数値リテラル一致
;;   <string>     文字列リテラル一致
;;   #t / #f      bool リテラル一致
;;   (quote x)    symbol/list literal 一致 (例: 'ok → (quote ok))
;;   (list ...)   list pattern (長さ一致 + 各要素を再帰 match)
;;
;; どれも match しなければ nil。 マクロ展開は eval 時、 body はネストした if + let* に。
;; hygienic ではない: pattern 内 symbol で binding 名を奪う事故に注意。
;;
;; 使用例:
;;   (match resp
;;     ((list 'ok v)    (process v))
;;     ((list 'err msg) (handle msg))
;;     (_               (default)))

(defmacro match (expr &rest clauses)
  (let ((g (gensym "v")))
    `(let ((,g ,expr))
       ,(_match-expand g clauses))))

(define _match-expand
  (lambda (v clauses)
    (if (null? clauses)
        nil
        (let* ((c     (car clauses))
               (pat   (car c))
               (body  (cdr c))
               (rest  (cdr clauses))
               (pred  (_match-pred v pat))
               (binds (_match-binds v pat))
               (then  (if (null? binds)
                          `(begin ,@body)
                          `(let* ,binds (begin ,@body)))))
          `(if ,pred ,then ,(_match-expand v rest))))))

;; pattern → 「v にこの pattern が match するか」 を判定する式を返す
(define _match-pred
  (lambda (v pat)
    (if (= pat '_) #t                                    ;; wildcard
        (if (symbol? pat) #t                             ;; var bind → 常に match
            (if (and (list? pat) (= (car pat) 'quote))
                `(= ,v ',(car (cdr pat)))                ;; (quote x) literal
                (if (and (list? pat) (= (car pat) 'list))
                    (_match-list-pred v (cdr pat))
                    `(= ,v ,pat)))))))                   ;; number/string/bool

(define _match-list-pred
  (lambda (v elems)
    (let ((n (length elems)))
      (fold (lambda (acc pair)
              (let ((i  (car pair))
                    (ep (car (cdr pair))))
                `(and ,acc ,(_match-pred `(nth ,i ,v) ep))))
            `(and (list? ,v) (= (length ,v) ,n))
            (zip (iota n) elems)))))

;; pattern → 露出する binding の (name expr) ペア list
(define _match-binds
  (lambda (v pat)
    (if (= pat '_) (list)
        (if (symbol? pat) (list (list pat v))
            (if (and (list? pat) (= (car pat) 'list))
                (_match-list-binds v (cdr pat))
                (list))))))

(define _match-list-binds
  (lambda (v elems)
    (fold (lambda (acc pair)
            (let ((i  (car pair))
                  (ep (car (cdr pair))))
              (append acc (_match-binds `(nth ,i ,v) ep))))
          (list)
          (zip (iota (length elems)) elems))))

;; ===========================================================================
;; エスカレーション分類 step (View 層 v2)
;; ===========================================================================
;; event の kind → 'sync | 'notify | 'silent の三層に分類する。
;;   sync   = 人間が応答するまで停止 (同期ゲート)
;;   notify = 停止しないが通知に積む (非同期通知)
;;   silent = ledger に沈むのみ (正常系)
;; 通知の受け口 (フェーズ2) がこの step を引いて振り分ける。
;; 分類規則は step なので実行時に書き換えられるが、 この binding の agent による
;; 再定義だけは常に人間の同期ゲートを通る (lispy 本体の GATE_HUMAN_SYNC で
;; ハードコード — 再帰の底は人間が握る)。
(define escalation-class
  (lambda (kind)
    (cond ((eq? kind "gate-reject")      'notify)   ; judge / gate の REJECT
          ((eq? kind "skill-reject")     'notify)   ; SKILL.md 更新の REJECT
          ((eq? kind "skill-update")     'notify)   ; SKILL.md の世代交代 (承認済み)
          ((eq? kind "step-repeat-fail") 'notify)   ; 同一 step の反復失敗
          (else                          'silent))))
